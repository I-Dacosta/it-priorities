# Postgres connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/it_priorities?schema=public"

# Better Auth
BETTER_AUTH_SECRET="generate with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"
# Comma-separated extra origins to trust, if the app answers on more hosts
# than BETTER_AUTH_URL and the Vercel-assigned domain.
BETTER_AUTH_TRUSTED_ORIGINS=""

# Microsoft Entra ID app registration (Azure Portal -> App registrations)
# Redirect URI to register: <BETTER_AUTH_URL>/api/auth/callback/microsoft-entra-id
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# Must be a real tenant GUID (Azure Portal -> Entra ID -> Overview -> Tenant ID),
# not "common"/"organizations"/"consumers".
MICROSOFT_TENANT_ID=""

# The assistant needs no configuration: it runs each user's Codex
# subscription in a Vercel Sandbox, authenticated with the deployment's own
# OIDC token. On Vercel that is automatic. Locally, run `vercel env pull`
# once so .env.local carries VERCEL_OIDC_TOKEN; without it the Assistant page
# reports itself unavailable and the rest of the app is unaffected.

# Optional: Application Insights RUM (browser). Leave unset to disable.
NEXT_PUBLIC_APPINSIGHTS_CONNECTION_STRING=""
