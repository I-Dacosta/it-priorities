# Postgres connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/it_priorities?schema=public"

# Better Auth
BETTER_AUTH_SECRET="generate with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# Microsoft Entra ID app registration (Azure Portal -> App registrations)
# Redirect URI to register: <BETTER_AUTH_URL>/api/auth/callback/microsoft-entra-id
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# Must be a real tenant GUID (Azure Portal -> Entra ID -> Overview -> Tenant ID),
# not "common"/"organizations"/"consumers".
MICROSOFT_TENANT_ID=""

# codex-bridge companion service (services/codex-bridge) — runs the real
# `codex` CLI per user on a persistent host. Leave both blank to run without
# the assistant; the app builds and runs, the Assistant page just reports it
# as unavailable.
CODEX_BRIDGE_URL=""
CODEX_BRIDGE_API_KEY=""

# Optional: Application Insights RUM (browser). Leave unset to disable.
NEXT_PUBLIC_APPINSIGHTS_CONNECTION_STRING=""
