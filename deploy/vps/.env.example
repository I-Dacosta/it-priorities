# =============================================================================
# IT Priorities — VPS stack environment
# =============================================================================
#
# FORWARD-LOOKING. Nothing here is wired up yet: this is the full variable set
# the VPS stack in docs/platform-and-feature-plan.md will need, written now so
# Phase 1 starts from a list rather than from memory. Variable names are
# proposals until Phases 1-2 implement them.
#
# Copy to `.env` beside the compose file on the VPS and fill in. That `.env` is
# gitignored and must never be committed.
#
# The "Phase" column in the plan decides what you need when:
#   Phases 1-3 (cutover)   — everything down to and including BACKUPS
#   Phase 5  (notifications) — NOTIFICATIONS
#   Phase 6  (mail)          — MICROSOFT GRAPH and AI AUTOMATION
#   Phase 7  (assistant)     — AI AUTOMATION
#
# Generate every secret below with:
#   openssl rand -base64 32     (or `-base64 24` for shorter keys)
# Never reuse the values currently set in Vercel — cutover is a good moment to
# rotate, and the Vercel ones are stored as sensitive and cannot be read back.
# =============================================================================


# --- HOSTS AND TLS -----------------------------------------------------------
# Consumed by: caddy, api

# Where the API answers. The static UI on Vercel calls this host directly.
API_DOMAIN="api.it.aquatiq.com"

# Where the UI is served from. Used for the CORS allow-list and as the default
# post-sign-in redirect. No trailing slash.
APP_ORIGIN="https://it.aquatiq.com"

# Let's Encrypt registration address for Caddy. A real monitored mailbox:
# expiry warnings go here.
ACME_EMAIL="it@aquatiq.com"


# --- POSTGRES ----------------------------------------------------------------
# Consumed by: postgres (the first three, at first boot only), api, worker

POSTGRES_USER="itpriorities"
POSTGRES_PASSWORD=""
POSTGRES_DB="it_priorities"

# Service name `postgres` resolves on the compose network; the database is not
# published to the host, so there is no port to expose and no TLS to terminate.
DATABASE_URL="postgresql://itpriorities:CHANGE_ME@postgres:5432/it_priorities?schema=public"

# Prisma Migrate wants a direct connection. On the VPS this is the same URL —
# there is no pooler in front of Postgres, unlike Neon. Kept explicit so the
# migrate commands do not have to change between environments.
DIRECT_DATABASE_URL="postgresql://itpriorities:CHANGE_ME@postgres:5432/it_priorities?schema=public"


# --- AUTH --------------------------------------------------------------------
# Consumed by: api

BETTER_AUTH_SECRET=""

# The API's own public URL. OAuth callbacks are built from this, so the Azure
# redirect URI must be <BETTER_AUTH_URL>/api/auth/callback/microsoft-entra-id
BETTER_AUTH_URL="https://api.it.aquatiq.com"

# The UI lives on a different host from the API, so its origin must be trusted
# explicitly or Better Auth rejects the sign-in POST with 403 "Invalid origin".
# Comma-separated.
BETTER_AUTH_TRUSTED_ORIGINS="https://it.aquatiq.com"

# The session cookie has to be readable by both hosts, so it is issued for the
# parent domain rather than for the API host alone. Leading dot intended.
# Requires SameSite=None and Secure, which Caddy's TLS already satisfies.
AUTH_COOKIE_DOMAIN=".aquatiq.com"


# --- MICROSOFT ENTRA ID (sign-in) --------------------------------------------
# Consumed by: api
#
# The same app registration as today. Add the new redirect URI
# https://api.it.aquatiq.com/api/auth/callback/microsoft-entra-id alongside the
# existing Vercel one so both stacks can sign in during the cutover.
#
# Keep "Allow public client flows" set to No — this is a confidential client
# and Azure rejects the secret (AADSTS700025) if it is marked public.

MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# A real tenant GUID, not "common"/"organizations"/"consumers".
MICROSOFT_TENANT_ID=""


# --- CODEX RUNNER ------------------------------------------------------------
# Consumed by: api (the first two), codex-runner (the rest)
#
# Replaces the Vercel Sandbox. One `codex app-server` process per call, each
# user's credential on a persistent volume. No OAuth token reaches the database.

# Reachable only on the compose network; never published to the host.
CODEX_RUNNER_URL="http://codex-runner:8080"

# Shared secret between api and codex-runner. Compared with a timing-safe
# check, so any length works; 32 bytes is plenty.
CODEX_RUNNER_API_KEY=""

# Per-user CODEX_HOME directories live under here. Must be a mounted volume —
# a bind mount or named volume — or every redeploy signs everyone out.
CODEX_SUBSCRIPTION_HOME="/data/codex-subscriptions"

# Path to the codex binary inside the runner image. Only set this if the image
# installs it somewhere other than the default PATH entry.
CODEX_APP_SERVER_COMMAND="codex"


# --- BACKUPS -----------------------------------------------------------------
# Consumed by: worker (or a host cron, whichever Phase 1 settles on)
#
# A backup that stays on the same VPS is not a backup. Send it somewhere else.

# Any rclone remote, an S3-compatible bucket, or a second host over SSH.
BACKUP_DESTINATION=""
BACKUP_ENCRYPTION_KEY=""
# Cron expression, VPS local time. Default: 02:30 nightly.
BACKUP_SCHEDULE="30 2 * * *"
BACKUP_RETENTION_DAYS="30"


# --- NOTIFICATIONS (Phase 5) -------------------------------------------------
# Consumed by: worker

# Incoming webhook for the channel that receives board activity. Graph-based
# posting (needed for @mentions of real people) uses the GRAPH_* values below
# instead, so this is the simpler of the two paths.
TEAMS_WEBHOOK_URL=""

# Digest schedules, VPS local time. Daily is weekdays only; the leadership
# digest is Monday morning.
TZ="Europe/Oslo"
DIGEST_DAILY_SCHEDULE="0 8 * * 1-5"
DIGEST_WEEKLY_SCHEDULE="0 8 * * 1"


# --- MICROSOFT GRAPH (Phase 6, mail) -----------------------------------------
# Consumed by: worker
#
# A SEPARATE app registration from sign-in above: this one holds application
# permissions (Mail.Read, Mail.ReadWrite) that need admin consent, and mixing
# them with the delegated sign-in app makes the blast radius bigger than it
# needs to be.
#
# Scope it to one mailbox with an Exchange application access policy:
#   New-ApplicationAccessPolicy -AppId <id> -PolicyScopeGroupId <mailbox> \
#     -AccessRight RestrictAccess
# Without that policy the app can read EVERY mailbox in the tenant.

GRAPH_TENANT_ID=""
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""

# The shared mailbox triage reads. Not a personal inbox — see the plan.
GRAPH_SHARED_MAILBOX="it@aquatiq.com"

# Delta-query poll interval in seconds. Graph webhook subscriptions expire in
# under three days, so polling is the simpler path.
MAIL_SYNC_INTERVAL_SECONDS="180"


# --- AI AUTOMATION (Phases 6-7) ----------------------------------------------
# Consumed by: worker, api
#
# Background AI — triage, reply drafts, task plans — runs on a COMPANY key, not
# on anyone's personal Codex subscription. Fill in exactly one of the two
# blocks below; AI_PROVIDER decides which is read.

# "foundry" | "anthropic"
AI_PROVIDER="foundry"

# Option A — Claude via Microsoft Foundry. Preferred when available in the
# tenant's EU region: same tenant, enterprise data terms, EU residency.
FOUNDRY_ENDPOINT=""
FOUNDRY_API_KEY=""
FOUNDRY_DEPLOYMENT=""

# Option B — Anthropic API directly.
ANTHROPIC_API_KEY=""

# Triage is high-volume and simple, so it runs on a small model; plans and
# reply drafts are lower-volume and benefit from a larger one.
AI_TRIAGE_MODEL="claude-haiku-4-5-20251001"
AI_DRAFTING_MODEL="claude-sonnet-5"

# Below this confidence a triage result is never auto-surfaced as a suggested
# task; it waits for a human in the Suggested inbox regardless.
AI_TRIAGE_MIN_CONFIDENCE="0.7"


# --- OBSERVABILITY (optional) ------------------------------------------------

# Server-side errors. Leave unset to disable.
APPINSIGHTS_CONNECTION_STRING=""

# Where an uptime check pings. Any external monitor; the point is that it is
# not on this VPS.
HEALTHCHECK_URL=""


# =============================================================================
# NOT SET HERE — the static UI on Vercel
# =============================================================================
# The Next.js static export needs exactly one variable, set in the Vercel
# project rather than in this file. It is baked into the bundle at build time
# and is public by definition, so it holds no secret:
#
#   NEXT_PUBLIC_API_BASE_URL="https://api.it.aquatiq.com"
#
# Optional there too: NEXT_PUBLIC_APPINSIGHTS_CONNECTION_STRING for browser RUM.
#
# Everything the app currently reads at runtime on Vercel — DATABASE_URL,
# BETTER_AUTH_*, MICROSOFT_*, CRON_SECRET — moves to this file and should be
# DELETED from the Vercel project once the cutover holds. Leaving them there
# after the migration is a credential lying around with nothing reading it.
# =============================================================================
