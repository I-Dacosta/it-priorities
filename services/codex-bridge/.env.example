# Shared secret the Next.js app sends as X-Internal-API-Key. Generate with:
#   openssl rand -base64 32
CODEX_BRIDGE_API_KEY=""

# Where each user's Codex credentials live. Must be a persistent volume —
# on Azure App Service only /home survives restarts.
CODEX_SUBSCRIPTION_HOME="/data/codex-subscriptions"

# Path to the codex binary, if it isn't on PATH.
CODEX_APP_SERVER_COMMAND="codex"

PORT="8080"
